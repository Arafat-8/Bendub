
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Core Identity Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.uid == "GeRpmM5MrHRj9iHCsMLDw0x9vf32" ||
        (request.auth.token.email != null && request.auth.token.email == "gruarafat8@gmail.com")
      );
    }
    
    function isAdmin() {
      return isMasterAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)));
    }
    
    function isMod() {
      return isAdmin() || (isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["moderator", "admin"])
      ));
    }
    
    function isMember() {
      // Master admin always has access
      if (isMasterAdmin()) {
        return true;
      }
      
      // Check for explicit admin/user records
      return isAdmin() || (isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)) ||
          exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower()))
        ))
      ));
    }

    // Collection Authorizations
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      
      match /history/{videoId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /videos/{videoId} {
      allow read: if isMember();
      allow write: if isMod();
    }

    match /categories/{categoryId} {
      allow read: if isMember();
      allow write: if isMod();
    }

    match /invites/{inviteId} {
      allow read: if isMod();
      allow write: if isMod();
    }

    match /settings/config {
      allow read: if true; 
      allow write: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }
    
    match /drive_folders/{folderId} {
      allow read: if isMember();
      allow write: if isMod();
    }
    
    match /allowed_users/{email} {
      allow read: if isMember();
      allow write: if isMod();
    }
    
    match /admin_users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
